modules = ["nodejs-20", "web"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5173

[[ports]]
localPort = 8081

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Web app"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Mobile app"

[[workflows.workflow]]
name = "Web app"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd client/web && npm run dev -- --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Mobile app"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd client/mobile && npx expo start --port 3000 --host lan"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "console"
