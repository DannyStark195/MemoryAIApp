modules = ["nodejs-20", "web"]

[nix]
channel = "stable-25_05"
packages = ["codex"]

[agent]
expertMode = true

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5173
externalPort = 5173
exposeLocalhost = true

[[ports]]
localPort = 5174
externalPort = 3002
exposeLocalhost = true

[[ports]]
localPort = 8081

[[ports]]
localPort = 8082
externalPort = 3001

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Web app"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Mobile app"

[[workflows.workflow]]
name = "Web app"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd client/web && npm run dev -- --host 0.0.0.0 --port 3000"
waitForPort = 3000

[[workflows.workflow]]
name = "Mobile app"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd client/mobile && npx expo start --port 5000 --host lan"
waitForPort = 5000
